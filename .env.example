# Copy this file to .env before starting the Compose stack.
# This template is not loaded automatically by the application.

# -----------------------------------------------------------------------------
# Web build and Express BFF
# VITE_* values are compiled into the frontend; rebuild after changing them.
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=/api
VITE_ENABLE_OPERATOR_CONSOLE=false
API_TARGET=http://docmesh-doc:8000
API_PREFIX=/api
WEB_PORT=8080

# Keep operator routes and browser-supplied context headers disabled by default.
# Enable them only behind a trusted authorization gateway/operator network.
ALLOW_OPERATOR_ROUTES=false
FORWARD_TRUSTED_CONTEXT_HEADERS=false

# -----------------------------------------------------------------------------
# DocMesh application
# -----------------------------------------------------------------------------
DOCMESH_IMAGE=ghcr.io/kyundae-kim/docmesh-doc:v0.7.0
DMS_METADATA_BACKEND=sqlite
SQLITE_PATH=/data/docmesh.sqlite3
DMS_APPLICATION_USER_ID=docmesh-doc
DMS_MAX_FILE_SIZE=104857600

# Leave empty for the default same-origin deployment; otherwise use a prefix
# such as /dms and align API_PREFIX and VITE_API_BASE_URL accordingly.
ROOT_PATH=

# -----------------------------------------------------------------------------
# MinIO
# MinIO is required even when SQLite is used. The Compose file does not create
# a separate application user, so the DMS credentials match the root credentials
# in this local template. Replace both secret values before real deployment.
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me-use-a-long-random-value
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=change-me-use-a-long-random-value
MINIO_BUCKET=documents
MINIO_SECURE=false
MINIO_REGION=
