# Vite build-time API base. /api is proxied by the web container.
VITE_API_BASE_URL=/api

# Public web port and image tag.
WEB_PORT=8080
WEB_IMAGE=docmesh-doc-web:latest

# The DocMesh API image must already exist locally or be available in a registry.
DOCMESH_IMAGE=docmesh-doc:latest

# MinIO credentials. Replace the password before deployment.
MINIO_ROOT_USER=docmesh-admin
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
MINIO_BUCKET=documents
