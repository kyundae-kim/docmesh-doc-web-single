# Vite build-time API base. /api is proxied by the web/BFF container.
VITE_API_BASE_URL=/api
# Keep the operator console disabled unless an external authorization boundary exists.
VITE_ENABLE_OPERATOR_CONSOLE=false

# Express BFF and public web port.
API_TARGET=http://docmesh-doc:8000
API_PREFIX=/api
WEB_PORT=8080
ALLOW_OPERATOR_ROUTES=false
FORWARD_TRUSTED_CONTEXT_HEADERS=false

# DocMesh application image and v0.7 application identity.
DOCMESH_IMAGE=ghcr.io/kyundae-kim/docmesh-doc:v0.7.0
DMS_METADATA_BACKEND=sqlite
SQLITE_PATH=/data/docmesh.sqlite3
DMS_APPLICATION_USER_ID=docmesh-doc
DMS_MAX_FILE_SIZE=104857600
# Optional external application prefix; keep empty for the default same-origin stack.
ROOT_PATH=

# MinIO is required even when SQLite is used. These are local development values only.
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me-use-a-long-random-value
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=change-me-use-a-long-random-value
MINIO_BUCKET=documents
MINIO_SECURE=false
